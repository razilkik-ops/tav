# Серверный ключ AIAI.BY из https://console.aiai.by/keys.
# Не используйте префикс VITE_ — иначе ключ попадёт в браузерную сборку.
DEEPSEEK_API_KEY=your_aiai_api_key

# Необязательно: endpoint и модель можно заменить без изменения кода.
DEEPSEEK_API_URL=https://api.aiai.by/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
