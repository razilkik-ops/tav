{
  "name": "tav-import",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "cf:dev": "npm run build && wrangler dev",
    "cf:check": "npm run build && wrangler deploy --dry-run",
    "cf:deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "wrangler": "^4.125.0"
  }
}
